<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: scripts/install-launchd.sh fills in the placeholders (UV, REPO, HOME, PATH and
  LOGS, each between double underscores) and writes the result to
  ~/Library/LaunchAgents/dev.jarvis.agent.plist. Do not load this file directly. They are
  not spelled out in this comment: a value rendered into it that held "-" twice in a row
  would end the comment early and leave a plist launchd refuses.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.jarvis.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>--project</string>
        <string>__REPO__</string>
        <string>jarvis</string>
        <string>serve</string>
    </array>

    <!-- `jarvis serve` reads .env from the working directory. -->
    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd agents start with a bare PATH, so the installer's own is rendered here:
             subagents find what a terminal finds. Re-run the installer after changing it. -->
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOGS__/jarvis.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/jarvis.err.log</string>
</dict>
</plist>
