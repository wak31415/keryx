<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: scripts/install-launchd.sh fills in the placeholders (UV, REPO, HOME, PATH, LOGS,
  KERYX_HOME and the four XDG_*_HOME, each between double underscores) and writes the result to
  ~/Library/LaunchAgents/dev.keryx.voice.plist. Do not load this file directly. They are
  not spelled out in this comment: a value rendered into it that held "-" twice in a row
  would end the comment early and leave a plist launchd refuses.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.keryx.voice</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>--project</string>
        <string>__REPO__</string>
        <string>keryx</string>
        <string>models</string>
        <string>serve</string>
        <string>voice</string>
    </array>

    <!-- `keryx models serve` reads the settings and becomes the server: change the model with
         `keryx config set` and load this agent again. -->
    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd agents start with a bare PATH, so the installer's own is rendered here:
             the server is found where a terminal finds it. -->
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <!-- Where the settings are (config.toml, secrets.toml, the PIN), and the XDG
             directories everything else is found under: the installer's, so the agent
             resolves exactly what its terminal did. -->
        <key>KERYX_HOME</key>
        <string>__KERYX_HOME__</string>
        <key>XDG_CONFIG_HOME</key>
        <string>__XDG_CONFIG_HOME__</string>
        <key>XDG_DATA_HOME</key>
        <string>__XDG_DATA_HOME__</string>
        <key>XDG_STATE_HOME</key>
        <string>__XDG_STATE_HOME__</string>
        <key>XDG_CACHE_HOME</key>
        <string>__XDG_CACHE_HOME__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOGS__/keryx-voice.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGS__/keryx-voice.err.log</string>
</dict>
</plist>
