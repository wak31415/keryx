# Template: scripts/install-systemd.sh fills in __CLOUDFLARED__, __PATH__, __LOGS__,
# __TUNNEL__ and __PORT__ and writes the result to ~/.config/systemd/user/cloudflared.service.
# Do not enable this file directly.
#
# The tunnel is what Twilio reaches: https://PUBLIC_HOST/twilio/voice -> localhost:__PORT__.
# It needs the named tunnel to exist already (`cloudflared tunnel create __TUNNEL__` plus
# `cloudflared tunnel route dns __TUNNEL__ PUBLIC_HOST`), which is a one-time browser login.

[Unit]
Description=Cloudflare tunnel for Jarvis

[Service]
Type=simple
ExecStart=__CLOUDFLARED__ tunnel --no-autoupdate --protocol http2 run --url http://localhost:__PORT__ __TUNNEL__
Environment="PATH=__PATH__"
Restart=always
RestartSec=5
StandardOutput=append:__LOGS__/cloudflared.out.log
StandardError=append:__LOGS__/cloudflared.err.log

[Install]
WantedBy=default.target
