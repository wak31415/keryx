# Template: scripts/install-systemd.sh fills in __UV__ and __REPO__, plus its own PATH,
# JARVIS_HOME, the four XDG base directories and the log directory under STATE_DIR, and
# writes the result to ~/.config/systemd/user/jarvis.service. Do not enable this file
# directly. (Those last ones are not named here as placeholders: a value rendered into a
# comment that ended in a backslash would carry the comment onto the next line.)
#
# The Linux host runs the phone channel only: openwakeword cannot be installed here (see
# pyproject.toml), so the wake word lives on the macOS machine.

[Unit]
Description=Jarvis voice agent (phone channel)

[Service]
Type=simple
# The checkout: `jarvis restart` reads its version. Nothing here is read as configuration.
WorkingDirectory=__REPO__
ExecStart=__UV__ run --project __REPO__ jarvis serve --no-wakeword
# The user manager's PATH is bare, so the installer's own is rendered here: subagents find
# what a terminal finds (nvm/npx, pixi, conda, cargo, ~/.local/bin). Re-run the installer
# after changing it.
Environment="PATH=__PATH__"
# Where the settings are (config.toml, secrets.toml, the PIN), and the XDG directories
# everything else is found under: the installer's, rendered here, so the service resolves
# exactly what its terminal did. The user manager's own may differ, or be unset.
Environment="JARVIS_HOME=__JARVIS_HOME__"
Environment="XDG_CONFIG_HOME=__XDG_CONFIG_HOME__"
Environment="XDG_DATA_HOME=__XDG_DATA_HOME__"
Environment="XDG_STATE_HOME=__XDG_STATE_HOME__"
Environment="XDG_CACHE_HOME=__XDG_CACHE_HOME__"
# Restart covers a crash and the "started before the network was up" case at boot.
Restart=always
RestartSec=5
# STATE_DIR/logs, where `jarvis restart` reads them back from.
StandardOutput=append:__LOGS__/jarvis.out.log
StandardError=append:__LOGS__/jarvis.err.log

[Install]
WantedBy=default.target
