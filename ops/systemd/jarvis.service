# Template: scripts/install-systemd.sh fills in __UV__, __REPO__, __PATH__ and __LOGS__ and
# writes the result to ~/.config/systemd/user/jarvis.service. Do not enable this file
# directly.
#
# The Linux host runs the phone channel only: openwakeword cannot be installed here (see
# pyproject.toml), so the wake word lives on the macOS machine.

[Unit]
Description=Jarvis voice agent (phone channel)

[Service]
Type=simple
# `jarvis serve` reads .env from the working directory.
WorkingDirectory=__REPO__
ExecStart=__UV__ run --project __REPO__ jarvis serve --no-wakeword
# The user manager's PATH is bare, so the installer's own is rendered here: subagents find
# what a terminal finds (nvm/npx, pixi, conda, cargo, ~/.local/bin). Re-run the installer
# after changing it.
Environment="PATH=__PATH__"
# Restart covers a crash and the "started before the network was up" case at boot.
Restart=always
RestartSec=5
# DATA_DIR/logs, where `jarvis restart` reads them back from.
StandardOutput=append:__LOGS__/jarvis.out.log
StandardError=append:__LOGS__/jarvis.err.log

[Install]
WantedBy=default.target
