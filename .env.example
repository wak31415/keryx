# Copy to .env and fill in. See docs/superpowers/specs/2026-08-18-jarvis-voice-agent-design.md §3.4.

# --- OpenAI Realtime (required) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=cedar
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Answers the voice model's own web_search tool, via the Responses API.
OPENAI_WEB_SEARCH_MODEL=gpt-5.4-mini

# --- Claude Agent SDK (subagents) ---
# Auth, in order of precedence (leave both blank to use your Claude subscription
# login — run `claude /login` once; for headless/launchd use `claude setup-token`
# and put the token below):
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
SUBAGENT_MODEL=claude-opus-5
SUBAGENT_MAX_TURNS=200
SUBAGENT_MAX_BUDGET_USD=10.0

# --- Twilio (phone channel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# --- Access control ---
# Comma-separated E.164 numbers allowed to call in, e.g. +15551234567,+15557654321
ALLOWED_CALLERS=
# Explicit owner number; defaults to the first entry in ALLOWED_CALLERS if unset.
OWNER_NUMBER=
# PIN required for destructive task kinds (coding/cowork) placed over the phone.
# If unset, those task kinds are refused on the phone channel.
JARVIS_PIN=

# --- Networking ---
# Public hostname Twilio can reach for webhooks/media streams: the hostname routed to
# your Cloudflare tunnel, e.g. jarvis.example.com.
PUBLIC_HOST=
# Name of the Cloudflare tunnel to run. Read by scripts/dev.sh and
# scripts/install-systemd.sh only (not by jarvis itself); defaults to "jarvis".
CLOUDFLARE_TUNNEL=
HOST=127.0.0.1
PORT=8080

# --- Projects ---
# JSON object mapping short project names to absolute paths, e.g. {"jarvis": "/home/me/jarvis"}
PROJECTS={}
PROJECTS_ROOT=~/Local/coding_projects
# Where the Claude CLI keeps its skills. They are listed in the voice prompt so Jarvis
# knows what the subagents are good at without you naming a skill out loud.
SKILLS_DIR=~/.claude/skills

# --- Data storage ---
DATA_DIR=~/.jarvis

# --- Task concurrency / limits ---
MAX_CONCURRENT_TASKS=3
DISPATCH_WAIT_MAX_SECONDS=25
LOCAL_SILENCE_TIMEOUT=30

# --- Turn taking (how long Jarvis waits before deciding you have finished) ---
# semantic: waits on whether the sentence sounds finished, so a pause to think does not
# cut you off (eagerness low = the most patient). server: a plain silence timer instead,
# VAD_SILENCE_MS long.
VAD_MODE=semantic
VAD_EAGERNESS=low
VAD_SILENCE_MS=1200
MAX_CALL_SECONDS=1800
DAILY_TASK_CAP=50

# --- Wake word (local channel) ---
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5

# --- Report links ---
# Secret used to sign /reports/{id} links. If unset, a random one is generated and
# persisted at DATA_DIR/report_secret.
REPORT_SECRET=

# --- Google integration ---
# Left blank, the OAuth client is read from GOOGLE_CLIENT_SECRETS_FILE below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=
# The OAuth client JSON from the Google console (installed- or web-client shape).
GOOGLE_CLIENT_SECRETS_FILE=.secrets/client_secret.json
# Attach the workspace-mcp server to subagents. Off: the Claude CLI's own claude.ai
# connectors already carry Gmail/Calendar/Drive, authorized. Turn this on only where the
# subagents authenticate with an API key and so have no connectors.
GOOGLE_WORKSPACE_MCP=false

# --- Slack ---
# Where "send me that on Slack" goes. Left blank, both are read from the auto-research
# skill's slack-research MCP server config, so there is only one Slack app to rotate.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- Logging ---
LOG_LEVEL=INFO

# --- Dev/test escape hatches ---
# Skip Twilio request-signature validation (local dev without a real Twilio webhook).
DEBUG_SKIP_TWILIO_VALIDATION=false
# Use a fake in-process agent runner instead of the real Claude Agent SDK.
FAKE_AGENTS=false

# --- Billing (the voice model's `check_billing`; read-only) -----------------
# Whose bill to report: auto (=openai, the key the voice agent itself runs on),
# openai, or anthropic. The model can also name one per call.
BILLING_PROVIDER=auto
# An *Admin* key. The ordinary OPENAI_API_KEY cannot read /v1/organization/costs;
# left blank, billing tries it anyway and reports the 401 rather than going quiet.
# https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=
# Narrow the spend figure to one project (costs have no finer filter than this).
OPENAI_BILLING_PROJECT_ID=
# Narrow *token usage* (not spend) to one key, if you know its key_… id.
OPENAI_BILLING_API_KEY_ID=
# An sk-ant-admin… key, for what the subagents have cost.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_BILLING_WORKSPACE_ID=
# What you call a month's budget. Neither provider serves one over the API, so the
# spoken "…percent of the budget" is only as real as this number. Blank: not spoken.
BILLING_MONTHLY_BUDGET=
