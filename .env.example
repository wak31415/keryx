# Copy to .env and fill in. See docs/superpowers/specs/2026-08-18-jarvis-voice-agent-design.md §3.4.

# --- OpenAI Realtime (required) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=cedar
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Answers the voice model's own web_search tool, via the Responses API.
OPENAI_WEB_SEARCH_MODEL=gpt-5.4-mini

# --- Coding agents (subagents); `uv run jarvis setup-agent` prints these for you ---
# The agent a task runs on when you do not name one out loud.
AGENT_BACKEND=claude
# Every agent a task may be sent to, comma-separated; blank is AGENT_BACKEND alone.
AGENTS_ENABLED=
# The longest one subagent run may take, on any agent, in seconds (0 is no limit).
SUBAGENT_TIMEOUT_S=10800

# --- Claude (subagents on the Claude Agent SDK) ---
# Auth, in order of precedence (leave both blank to use your Claude subscription
# login — run `claude /login` once; for headless/launchd use `claude setup-token`
# and put the token below):
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
SUBAGENT_MODEL=claude-opus-5
SUBAGENT_MAX_TURNS=200
SUBAGENT_MAX_BUDGET_USD=10.0

# --- Codex (subagents on the OpenAI Codex CLI) ---
# Auth, in the same order (leave both blank to use your ChatGPT plan — run `codex login`
# once, or `codex login --device-auth` on a machine with no browser). OPENAI_API_KEY above
# is never used for Codex: set CODEX_API_KEY if you want per-token billing.
CODEX_API_KEY=
CODEX_ACCESS_TOKEN=
# Blank is Codex's own default model.
CODEX_MODEL=

# --- Twilio (phone channel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Whether Jarvis may text at all. Off by default: many Twilio accounts lack SMS permission
# for their region, and Slack is the written channel when you ask for one. Outbound
# *calls* are unaffected — which matters, because the restart watchdog's alert is a call,
# and it is the last thing working when Jarvis itself is down.
SMS_ENABLED=false

# --- The owner ---
# What Jarvis calls you in the prompts it is handed ("You are Jarvis, <name>'s personal
# assistant"). Blank is "the owner". Only a name: the rest of what it knows about you is its
# memory, which `jarvis init` starts.
OWNER_NAME=

# --- Access control ---
# Comma-separated E.164 numbers allowed to call in, e.g. +15551234567,+15557654321
ALLOWED_CALLERS=
# Explicit owner number; defaults to the first entry in ALLOWED_CALLERS if unset.
OWNER_NUMBER=
# Required before Jarvis dispatches anything over the phone — every task, since there is
# one kind of task and it has the machine and the mailbox. Caller id is spoofable, so this
# is the real gate. **6 to 8 digits, and nothing but digits**: it is keyed on a phone
# keypad, so anything else could never be entered, and `jarvis serve` refuses to start on
# a PIN that does not conform. Left blank means no PIN, which is a different and safe
# thing: every dispatch from the phone is simply refused.
JARVIS_PIN=
# Three wrong PINs end a call; these hold across calls, and across restarts. When
# PIN_FAILURE_LIMIT wrong PINs pile up inside PIN_FAILURE_WINDOW_HOURS, PIN entry locks for
# PIN_LOCKOUT_MINUTES on every call — the right PIN included — and you are told once (an
# authorized call, Slack, or a text if texting is on). Past the limit each further wrong PIN
# locks it again, so guessing gets one try an hour. The price: whoever can make those calls
# can keep your own PIN locked too; see SECURITY.md. Clearing it by hand: stop Jarvis, delete
# DATA_DIR/pin-failures.json, start it again.
PIN_FAILURE_LIMIT=10
PIN_FAILURE_WINDOW_HOURS=24
PIN_LOCKOUT_MINUTES=60
# Whether a call is handed its standing briefing before the PIN: results you have not
# been told about, the memory, your project names, their briefs and the skills. On,
# because the PIN is the line between reading and acting, not between private and not —
# anyone who has this machine has this file and so has your PIN, so gating reads defended
# only against somebody spoofing one of your ALLOWED_CALLERS, and charged a keypad to
# every ordinary call. The trade-off is that such a spoofer hears what a call opens
# knowing. Off means a call before the PIN is told nothing of yours at all, and the
# read-only voice tools over the same material go back behind the PIN with it. Either way
# nothing that acts, and nothing that rewrites the memory, happens without the PIN.
BRIEFING_BEFORE_PIN=true

# --- Networking ---
# Public hostname Twilio can reach for webhooks/media streams: the hostname routed to
# your Cloudflare tunnel, e.g. jarvis.example.com.
PUBLIC_HOST=
# Name of the Cloudflare tunnel to run. Read by scripts/dev.sh and
# scripts/install-systemd.sh only (not by jarvis itself); defaults to "jarvis".
CLOUDFLARE_TUNNEL=
HOST=127.0.0.1
PORT=8080

# --- Projects ---
# JSON object mapping short project names to absolute paths, e.g. {"jarvis": "/home/me/jarvis"}
PROJECTS={}
# Where a task with no project starts; its subdirectories are the projects Jarvis knows by
# name. Never created: if it does not exist, such a task starts in DATA_DIR/workspace.
PROJECTS_ROOT=~/projects
# Where the Claude CLI keeps its skills. They are listed in the voice prompt so Jarvis
# knows what the subagents are good at without you naming a skill out loud.
SKILLS_DIR=~/.claude/skills

# --- Data storage ---
# Created 0700, with the files under it 0600: `calls/*.log` is every word of every call,
# and `tasks.db` is what you asked for and what came back.
DATA_DIR=~/.jarvis

# --- Retention ---
# Both are OFF at 0, which is what Jarvis has always done: nothing is ever deleted. A
# default that quietly removed your own call transcripts is not one worth shipping, so the
# feature is here and the policy is yours. The prune runs at the top of `jarvis serve`;
# `jarvis forget` does it on demand. One rule holds either way: a finished task you have
# not been told about yet is never deleted, however old — `reported_at` is the only record
# that you heard the result.
TRANSCRIPT_RETENTION_DAYS=0
TASK_RETENTION_DAYS=0

# --- The service manager (what `jarvis restart` asks) ---
# auto: systemd on Linux, launchd on macOS — but only for a process actually running as
# SERVICE_UNIT under it (its cgroup; launchd's job label), and for `jarvis restart` in a
# terminal only when that unit is installed. Anything else is unsupervised, which is a
# supported way to run — a `jarvis serve` started by hand, say — and everything works
# except restarting, which is refused because stopping would leave nothing to start it
# again. systemd / launchd skip the check and are taken at their word; none refuses.
# Blank SERVICE_UNIT means the installed default (jarvis.service / dev.jarvis.agent).
SERVICE_MANAGER=auto
SERVICE_UNIT=

# --- Task concurrency / limits ---
MAX_CONCURRENT_TASKS=3
DISPATCH_WAIT_MAX_SECONDS=25
LOCAL_SILENCE_TIMEOUT=30

# --- Turn taking (how long Jarvis waits before deciding you have finished) ---
# semantic: waits on whether the sentence sounds finished, so a pause to think does not
# cut you off. server: a plain silence timer instead, VAD_SILENCE_MS long.
VAD_MODE=semantic
# Semantic mode only: low waits longest, high jumps in soonest, auto means medium. It was
# low until 2026-08-26, which left about two seconds of silence at the end of every
# sentence — long enough to sound like it had not heard.
VAD_EAGERNESS=medium
# Server mode only. VAD_THRESHOLD is how loud counts as speech; VAD_PREFIX_MS is how much
# audio before the trigger is kept, so the first syllable is not clipped.
VAD_SILENCE_MS=1200
VAD_THRESHOLD=0.5
VAD_PREFIX_MS=300
# Background-noise suppression on what the model hears: auto picks by channel (near_field
# for a phone at your head, far_field for a mic across the room). Mostly this is about
# barge-in — noise the model mistakes for speech is noise that cuts it off.
NOISE_REDUCTION=auto
MAX_CALL_SECONDS=1800
DAILY_TASK_CAP=50
# Phone sessions open at once, each one a realtime session being paid for. Two, so a dropped
# call can be redialled while the old one is still saying goodbye; a call past it hears that
# the line is busy and never reaches the model.
MAX_PHONE_SESSIONS=2

# --- Wake word (local channel) ---
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5

# --- Report links ---
# Secret used to sign /reports/{id} links. If unset, a random one is generated and
# persisted at DATA_DIR/report_secret.
REPORT_SECRET=

# --- Google integration ---
# Left blank, the OAuth client is read from GOOGLE_CLIENT_SECRETS_FILE below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=
# The OAuth client JSON from the Google console (installed- or web-client shape).
GOOGLE_CLIENT_SECRETS_FILE=.secrets/client_secret.json
# Attach the workspace-mcp server to subagents. Off: the Claude CLI's own claude.ai
# connectors already carry Gmail/Calendar/Drive, authorized. Turn this on only where the
# subagents authenticate with an API key and so have no connectors.
GOOGLE_WORKSPACE_MCP=false

# --- Slack ---
# Where "send me that on Slack" goes, for the voice model's send_to_slack.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# The user-scope MCP server in ~/.claude.json that gives subagents Slack. Named, subagents
# are told to use it when you ask for something on Slack, and the two settings above fall
# back to that server's own config, so there is only one Slack app to rotate. Blank: no
# fallback, and subagents are told nothing about Slack.
SLACK_MCP_SERVER=

# --- The approval bridge (jarvis/approvals) ---
# A Claude Code prompt left unanswered on your screen becomes a phone call. Install the
# hook with scripts/install-claude-hook.sh; this end needs nothing but to be on.
APPROVALS_ENABLED=true
# How long a prompt waits before it rings, and how long the hook keeps waiting after that.
# The two added together are the longest the hook can block, so the `timeout` on the hook
# entry in ~/.claude/settings.json has to be comfortably larger than their sum.
APPROVAL_ESCALATE_SECONDS=300
APPROVAL_CALL_WINDOW_SECONDS=240
# However many prompts pile up. Alert fatigue is the real failure mode: a bridge that
# rings ten times a day gets muted, and then it is not there for the one that mattered.
APPROVAL_MAX_PER_HOUR=4
# HH:MM-HH:MM in which it never rings; may cross midnight, blank is never. Local time as
# the *host* sees it — Jarvis assumes the machine's timezone is yours.
APPROVAL_QUIET_HOURS=
# The only shell commands a keypad digit may ever run, each matched word for word against
# a command with no chaining, redirection, expansion or shell metacharacters in it. Only
# two entries may carry arguments, and only these (jarvis/approvals/policy.py): `git push`
# -u/-q/-v/-n, a remote name and plain branch or tag names; `git commit` -m/-a/-q and
# pathspecs. Anything else you add runs exactly as written or not at all. **This is an
# allowlist and it is the primary control**: a PermissionRequest hook returning `allow`
# appears to skip the CLI's own permissions.deny re-check, so whatever is named here is
# what a phone keypad can execute. Widening it widens exactly that — and a test runner in
# particular runs whatever the session last wrote into the working tree, which no
# read-back says.
APPROVAL_BASH_ALLOW=git push,git commit
# Where a file may be written by phone approval. Blank means PROJECTS_ROOT plus every
# project named in PROJECTS, which is usually what you want.
APPROVAL_ROOTS=

# --- Cluster stats (the voice model's `cluster_stats`; read-only; a worked example) ---
# Off until both CLUSTERS and CLUSTER_SSH_GUARD are set and the guard is on disk; until
# then the tool is not offered at all. Every Slurm read goes through the guard, never a
# connection of Jarvis's own: where cluster auth is 2FA behind an ssh ControlMaster, no
# non-interactive process can answer the second factor, and a direct attempt against a
# dead master *hangs* — a storm of those retries is how an address gets banned by the
# login nodes. The guard's contract is in src/jarvis/integrations/cluster.py.
# The clusters it may ask about, as JSON: {"name": "partition"}. The name is the ssh host
# alias the guard is handed and the word you say; the partition is where the GPUs are.
CLUSTERS={}
CLUSTER_SSH_GUARD=
# The whole wait, since every cluster is asked at once — and it is a wait inside a call.
CLUSTER_QUERY_TIMEOUT_S=20.0

# --- Logging ---
LOG_LEVEL=INFO

# --- Dev/test escape hatches ---
# Skip Twilio request-signature validation (local dev without a real Twilio webhook).
# `jarvis serve` refuses to answer the phone with this on while PUBLIC_HOST is set: behind a
# tunnel it would let anyone pose as Twilio.
DEBUG_SKIP_TWILIO_VALIDATION=false
# Use a fake in-process agent runner instead of the real Claude Agent SDK.
FAKE_AGENTS=false

# --- Billing (the voice model's `check_billing`; read-only) -----------------
# Whose bill to report: auto (=openai, the key the voice agent itself runs on),
# openai, or anthropic. The model can also name one per call.
BILLING_PROVIDER=auto
# An *Admin* key. The ordinary OPENAI_API_KEY cannot read /v1/organization/costs;
# left blank, billing tries it anyway and reports the 401 rather than going quiet.
# https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=
# Narrow the spend figure to one project (costs have no finer filter than this).
OPENAI_BILLING_PROJECT_ID=
# Narrow *token usage* (not spend) to one key, if you know its key_… id.
OPENAI_BILLING_API_KEY_ID=
# An sk-ant-admin… key, for what the subagents have cost.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_BILLING_WORKSPACE_ID=
# What you call a month's budget. Neither provider serves one over the API, so the
# spoken "…percent of the budget" is only as real as this number. Blank: not spoken.
BILLING_MONTHLY_BUDGET=
