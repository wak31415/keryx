# Copy to .env and fill in. See docs/superpowers/specs/2026-08-18-jarvis-voice-agent-design.md §3.4.

# --- OpenAI Realtime (required) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=cedar
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- Claude Agent SDK (subagents) ---
# Auth, in order of precedence (leave both blank to use your Claude subscription
# login — run `claude /login` once; for headless/launchd use `claude setup-token`
# and put the token below):
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
SUBAGENT_MODEL=claude-opus-5
SUBAGENT_MAX_TURNS=200
SUBAGENT_MAX_BUDGET_USD=10.0

# --- Twilio (phone channel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# --- Access control ---
# Comma-separated E.164 numbers allowed to call in, e.g. +15551234567,+15557654321
ALLOWED_CALLERS=
# Explicit owner number; defaults to the first entry in ALLOWED_CALLERS if unset.
OWNER_NUMBER=
# PIN required for destructive task kinds (coding/cowork) placed over the phone.
# If unset, those task kinds are refused on the phone channel.
JARVIS_PIN=

# --- Networking ---
# Public hostname Twilio can reach for webhooks/media streams: the hostname routed to
# your Cloudflare tunnel, e.g. jarvis.example.com.
PUBLIC_HOST=
# Name of the Cloudflare tunnel to run. Read by scripts/dev.sh and
# scripts/install-systemd.sh only (not by jarvis itself); defaults to "jarvis".
CLOUDFLARE_TUNNEL=
HOST=127.0.0.1
PORT=8080

# --- Projects ---
# JSON object mapping short project names to absolute paths, e.g. {"jarvis": "/home/me/jarvis"}
PROJECTS={}
PROJECTS_ROOT=~/Local/coding_projects
# Where the Claude CLI keeps its skills. They are listed in the voice prompt so Jarvis
# knows what the subagents are good at without you naming a skill out loud.
SKILLS_DIR=~/.claude/skills

# --- Data storage ---
DATA_DIR=~/.jarvis

# --- Task concurrency / limits ---
MAX_CONCURRENT_TASKS=3
DISPATCH_WAIT_MAX_SECONDS=25
LOCAL_SILENCE_TIMEOUT=30
MAX_CALL_SECONDS=1800
DAILY_TASK_CAP=50

# --- Wake word (local channel) ---
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5

# --- Report links ---
# Secret used to sign /reports/{id} links. If unset, a random one is generated and
# persisted at DATA_DIR/report_secret.
REPORT_SECRET=

# --- Google integration ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=

# --- Logging ---
LOG_LEVEL=INFO

# --- Dev/test escape hatches ---
# Skip Twilio request-signature validation (local dev without a real Twilio webhook).
DEBUG_SKIP_TWILIO_VALIDATION=false
# Use a fake in-process agent runner instead of the real Claude Agent SDK.
FAKE_AGENTS=false
